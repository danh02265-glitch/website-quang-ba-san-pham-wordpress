{
  "id": null,
  "uid": "wordpress-product-site",
  "title": "WordPress Product Site",
  "tags": ["wordpress", "docker", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Container CPU usage",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum(rate(container_cpu_usage_seconds_total{image!=\"\"}[5m])) by (name) * 100", "legendFormat": "{{name}}"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Container memory working set",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"refId": "A", "expr": "sum(container_memory_working_set_bytes{image!=\"\"}) by (name)", "legendFormat": "{{name}}"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Nginx active connections",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "hidden", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [{"refId": "A", "expr": "nginx_connections_active", "legendFormat": "active"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Nginx request rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "hidden", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [{"refId": "A", "expr": "rate(nginx_http_requests_total[5m])", "legendFormat": "requests/sec"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "MySQL connections",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "hidden", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [{"refId": "A", "expr": "mysql_global_status_threads_connected", "legendFormat": "connected"}]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "MySQL exporter status",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 15},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "center"},
      "targets": [{"refId": "A", "expr": "mysql_up", "legendFormat": "mysql"}]
    }
  ],
  "annotations": {"list": []},
  "links": []
}

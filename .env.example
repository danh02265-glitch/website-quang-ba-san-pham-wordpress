# Copy to .env and replace every value with a unique random value.
# Use only letters and numbers for passwords to avoid URL/SQL escaping issues.
MYSQL_DATABASE=wordpress
MYSQL_USER=wpapp
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_32_CHAR_HEX
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_32_CHAR_HEX
MYSQL_EXPORTER_USER=metrics
MYSQL_EXPORTER_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_32_CHAR_HEX

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_32_CHAR_HEX